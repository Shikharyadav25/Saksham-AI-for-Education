      "skill_id": "order_of_operations",
      "question_text": "What is the value of 18 - 3 * (4 - 7)^2?",
      "options": {
        "A": "-9",
        "B": "45",
        "C": "135",
        "D": "-45"
      },
      "correct_answer": "A",
      "distractor_rationales": {
        "B": "Calculated (-3)^2 as -9 and computed 18 - 3 * (-9) = 18 + 27 = 45.",
        "C": "Subtracted 18 - 3 = 15 first, violating PEMDAS hierarchy.",
        "D": "Treated 18 - 3*9 as -(18 + 27)."
      },
      "difficulty": 0.40,
      "discrimination": 1.5
    },
    {
