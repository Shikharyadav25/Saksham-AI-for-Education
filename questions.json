  "questions": [
    {
      "id": "q_int_01",
      "skill_id": "arithmetic_integers",
      "question_text": "Compute: -14 - (-8) + (-5)",
      "options": {
        "A": "-11",
        "B": "-27",
        "C": "-1",
        "D": "11"
      },
      "correct_answer": "A",
      "distractor_rationales": {
        "B": "Subtracted positive 8 instead of adding 8 from double negative.",
        "C": "Sign error on final addition of negative 5.",
        "D": "Neglected negative sign on the initial 14."
      },
      "difficulty": 0.25,
      "discrimination": 1.2
    },
    {
      "id": "q_int_02",
      "skill_id": "arithmetic_integers",
      "question_text": "Evaluate: (-3) * (-4) - (-12) / (-2)",
      "options": {
        "A": "6",
        "B": "18",
        "C": "-18",
        "D": "-6"
      },
      "correct_answer": "A",
      "distractor_rationales": {
        "B": "Treated (-12)/(-2) as negative 6 and subtracted it (adding 6).",
        "C": "Calculated (-3)*(-4) as -12.",
        "D": "Inverted all signs during evaluation."
      },
      "difficulty": 0.35,
      "discrimination": 1.4
    },
    {
